# Proveedor del LLM: google (default), openai o anthropic.
# El nombre del modelo sale de estas variables. No está clavado en el código.
# Para que Phoenix calcule el costo por ejecución, usá openai.
LLM_PROVIDER=openai

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Redis 8 (RedisJSON + RediSearch). AsyncRedisSaver.asetup() crea los índices.
REDIS_URL=redis://localhost:6379

# Phoenix local. En Docker Compose la API usa http://phoenix:6006/v1/traces.
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=intelligence

# 1: el worker corre dentro de la API. 0: correr aparte con python -m app.worker.
WORKER_IN_API=1

# Si el costo estimado de una ejecución pasa este límite (USD), el grafo pausa para aprobar.
COSTO_MAXIMO_USD=0.01

# Índice, namespace y modelo de embedding. Si PINECONE_API_KEY queda vacía, la búsqueda corre en memoria.
PINECONE_API_KEY=
INDEX_NAME=techcorp-rag-hibrido
PINECONE_NAMESPACE=politicas-internas
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
